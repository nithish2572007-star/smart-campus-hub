# ==========================================
# Smart Campus Hub - Environment Configuration
# ==========================================

# Port and Host
PORT=8000
HOST=0.0.0.0

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Option A: SQLite (Default for development and single-server deployment)
DATABASE_URL=sqlite:///./campus_hub.db

# Option B: PostgreSQL (Recommended for high concurrency / multi-container deployment)
# DATABASE_URL=postgresql://campus_admin:campus_secret@db:5432/campus_hub
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ------------------------------------------
# ML & Model Cache Configuration
# ------------------------------------------
# Path where Hugging Face sentence-transformers & CLIP models are stored
HF_HOME=/app/models_cache

# Set to 1 in air-gapped / offline deployments to skip HuggingFace version checks
HF_HUB_OFFLINE=1

# Match alert threshold (percentage, default: 80.0)
MATCH_ALERT_THRESHOLD=80.0
